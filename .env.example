# ==============================================================================
# WASHMITRA ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and provide your actual production API credentials.
# NEVER commit the real .env file to public version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Exposed to Browser via Vite build process)
# ------------------------------------------------------------------------------

# Supabase Project URL (Supabase Dashboard -> Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Supabase Dashboard -> Settings -> API -> anon / public key)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# (Optional) Google Maps API Key (Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_MAPS_PLATFORM_KEY=your_google_maps_api_key_here

# (Optional) Razorpay Public Key ID (Razorpay Dashboard -> Settings -> API Keys)
VITE_RAZORPAY_KEY_ID=rzp_live_your_public_key_id_here


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (NEVER expose to browser, keep strictly secret)
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Supabase Dashboard -> Settings -> API -> service_role key)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Google Gemini API Key (Google AI Studio -> Get API key)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Server Keys
RAZORPAY_KEY_ID=rzp_live_your_public_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Express Server Port (Optional, defaults to 3000)
PORT=3000
